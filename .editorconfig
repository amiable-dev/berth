# EditorConfig: https://editorconfig.org
#
# Biome (biome.json) formats TypeScript, JavaScript and JSON and reads this
# file too; keep the two in agreement (UTF-8, LF, 2 spaces, 100 columns).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,js,mjs,cjs}]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
